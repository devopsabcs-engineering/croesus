// evidence-kql.kusto
//
// Tenant sign-in log queries that CORROBORATE the Croesus mock SaaS flow.
//
// Scope and limits, read before using any result:
//
//   * No query here is a release gate on its own. Each one narrows a question;
//     none of them closes one.
//   * Sign-in logs record token ISSUANCE events. They do not record which bytes
//     a client presented on a later request, so nothing here can establish that
//     a specific token was, or was not, reused.
//   * A row showing one audience and a later row showing a different audience is
//     consistent with a delegated downstream exchange. It is equally consistent
//     with two independent token requests. Two distinct audiences, or two
//     distinct token identifiers, do not by themselves identify the grant that
//     produced either token.
//   * These tables do not name the grant type. A populated credential field
//     tells you a credential was used; it does not tell you which OAuth grant
//     was exercised.
//   * Categories populate independently. SigninLogs, the non-interactive table,
//     the service-principal table, and the audit table each have their own
//     population rules, and a given user action may land in one, several, or
//     none of them. Absence of a row in one table is not evidence that the
//     corresponding step did not happen.
//
// The authoritative per-request record is the API's own Application Insights
// telemetry: the OboExchange and ReplayAttempt custom events emitted by
// api/Telemetry/OboClaimLogger.cs. Those events carry the per-operation
// identifiers the application actually observed. The queries below take those
// observed identifiers as INPUT; they do not attempt to rediscover them by
// assuming one correlation identifier spans every leg of a flow.
//
// Placeholders to substitute before running (none are secrets):
//   <RUN_ID>              run identifier stamped on the App Insights events for
//                         one execution. Selects which OboExchange /
//                         ReplayAttempt events to read the per-operation
//                         identifiers from, and is carried through as an
//                         annotation column so runs cannot be conflated.
//   <RUN_START>/<RUN_END> ISO 8601 UTC bounds of that run.
//   <OBO_CORRELATION_ID_n>  leg2.correlationId values from the OboExchange
//                         events of that run: the correlation id MSAL sent on
//                         the outbound leg, observed rather than assumed.
//   <LEG1_TOKEN_ID_n>     leg1 token identifiers captured by the same events.
//   <API_SP_OBJECT_ID>    tenant service principal OBJECT id of the API app.
//   <BFF_SP_OBJECT_ID>    tenant service principal OBJECT id of the BFF app.
//   <GRAPH_SP_OBJECT_ID>  tenant service principal OBJECT id of Microsoft Graph.
//
// Resolve the object ids once per tenant. Microsoft Graph's APPLICATION id is a
// cross-tenant constant, but its SERVICE PRINCIPAL object id is tenant-specific,
// which is why the queries compare against the object id rather than against the
// well-known application id:
//   az ad sp show --id <API_CLIENT_ID> --query id -o tsv
//   az ad sp show --id <BFF_CLIENT_ID> --query id -o tsv
//   az ad sp show --id 00000003-0000-0000-c000-000000000000 --query id -o tsv
//
// Run each query block on its own; Log Analytics executes one query at a time.
// Every query is bounded in time. Widen a window deliberately, never by default.

// =============================================================================
// Query 1 - Run-scoped sign-in rows for the identifiers the application observed
//
// Selects only rows whose correlation id or unique token identifier appears in
// the set the application recorded for run <RUN_ID>. This is a membership test
// against observed values. It does not assume a shared correlation identifier
// and it does not join one leg to another.
//
// What this does NOT prove: that any listed token was presented to a downstream
// resource; that the rows shown belong to one logical user operation; that the
// set is complete, since a leg whose identifier the application did not capture
// cannot appear. Rows evidence issuance for the identifiers supplied, no more.
// =============================================================================
let runId = "<RUN_ID>";
let runStart = datetime(<RUN_START>);
let runEnd = datetime(<RUN_END>);
let observedCorrelationIds = dynamic(["<OBO_CORRELATION_ID_1>", "<OBO_CORRELATION_ID_2>"]);
let observedTokenIds = dynamic(["<LEG1_TOKEN_ID_1>", "<LEG1_TOKEN_ID_2>"]);
union
    (SigninLogs                      | extend SourceTable = "SigninLogs"),
    (AADNonInteractiveUserSignInLogs | extend SourceTable = "AADNonInteractiveUserSignInLogs")
| where TimeGenerated between (runStart .. runEnd)
| where CorrelationId in (observedCorrelationIds)
     or UniqueTokenIdentifier in (observedTokenIds)
| extend RunId = runId
| project TimeGenerated, RunId, SourceTable, CorrelationId, UniqueTokenIdentifier,
          AppId, AppDisplayName, ResourceIdentity, ResourceDisplayName,
          UserPrincipalName, ResultType, ResultDescription
| sort by TimeGenerated asc

// =============================================================================
// Query 2 - Resource legs resolved by tenant service principal object id
//
// Sign-in rows identify the resource by its service principal object id in THIS
// tenant. Comparing that column against a globally known application id is a
// category error that silently returns nothing. This query filters on object ids
// resolved from the tenant and reports the resolved identity beside each row, so
// the mapping is visible rather than implied.
//
// What this does NOT prove: which grant produced each row; that the rows are
// causally linked; that a token issued for one resource was later forwarded to
// another. It establishes only which resources were the target of token requests
// attributable to these clients inside the window.
// =============================================================================
let lookback = 1h;
let apiSpId = "<API_SP_OBJECT_ID>";
let bffSpId = "<BFF_SP_OBJECT_ID>";
let graphSpId = "<GRAPH_SP_OBJECT_ID>";
let knownResources = dynamic({
    "<API_SP_OBJECT_ID>": "Croesus API (tenant SP)",
    "<BFF_SP_OBJECT_ID>": "Croesus BFF (tenant SP)",
    "<GRAPH_SP_OBJECT_ID>": "Microsoft Graph (tenant SP)"
});
union
    (SigninLogs                      | extend SourceTable = "SigninLogs"),
    (AADNonInteractiveUserSignInLogs | extend SourceTable = "AADNonInteractiveUserSignInLogs")
| where TimeGenerated > ago(lookback)
| where ResourceIdentity in (apiSpId, bffSpId, graphSpId)
| extend ResolvedResource = tostring(knownResources[tostring(ResourceIdentity)])
| project TimeGenerated, SourceTable, AppId, AppDisplayName,
          ResourceIdentity, ResolvedResource, ResourceDisplayName,
          UserPrincipalName, CorrelationId, UniqueTokenIdentifier, ResultType
| sort by TimeGenerated asc

// =============================================================================
// Query 3 - Conditional Access evaluation, expanded per policy
//
// One sign-in is evaluated against many policies. Collapsing that to a single
// pass or fail hides which policy spoke and whether it was enforcing at the
// time. This expands the policy array and reports, for every policy touched: the
// policy identifier, the target resource, the EVALUATION MODE, and the result.
//
// Evaluation mode matters more than the result. A reportOnly result records what
// a policy WOULD have done; it did not gate the sign-in. Reading a report-only
// success as enforcement is the most common misuse of this data.
//
// What this does NOT prove: that an enforced policy applied to every request in
// a session; that a policy absent from a row is inactive; that a notApplied
// result reflects a decision rather than a scoping condition that was not met.
// =============================================================================
let lookback = 1h;
SigninLogs
| where TimeGenerated > ago(lookback)
| mv-expand caPolicy = todynamic(ConditionalAccessPolicies)
| extend PolicyId = tostring(caPolicy.id),
         PolicyName = tostring(caPolicy.displayName),
         PolicyResult = tostring(caPolicy.result)
| extend EvaluationMode = case(
             PolicyResult startswith "reportOnly", "ReportOnly",
             PolicyResult in ("success", "failure", "notApplied"), "Enforced",
             "Unknown")
| project TimeGenerated, UserPrincipalName, AppDisplayName,
          TargetResource = ResourceDisplayName, ResourceIdentity,
          PolicyId, PolicyName, EvaluationMode, PolicyResult,
          SignInResult = ResultType, CorrelationId
| sort by TimeGenerated desc

// =============================================================================
// Query 4 - Token Protection session binding (separate, optional exhibit)
//
// Reports the sign-in-session binding status where Token Protection populated
// it. This is a device-binding exhibit, unrelated to the questions the queries
// above address, and is kept separate so the two are not read together.
//
// The signal populates only for native-app clients on registered devices
// reaching resources that support it, and only when a Token Protection policy is
// in scope. For a browser client calling a custom API it will usually be empty.
//
// What this does NOT prove: anything about token reuse, grant type, or the
// Croesus flow. An empty result means the signal did not populate, which is the
// expected outcome here and is not a negative finding.
// =============================================================================
let lookback = 7d;
AADNonInteractiveUserSignInLogs
| where TimeGenerated > ago(lookback)
| where isnotempty(TokenProtectionStatusDetails)
| extend parsed = parse_json(TokenProtectionStatusDetails)
| extend BindingStatus = tostring(parsed["signInSessionStatus"]),
         BindingStatusCode = tostring(parsed["signInSessionStatusCode"])
| project TimeGenerated, UserPrincipalName, AppDisplayName, ResourceDisplayName,
          BindingStatus, BindingStatusCode, CorrelationId
| sort by TimeGenerated desc
