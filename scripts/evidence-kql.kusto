// evidence-kql.kusto
//
// Corroborating sign-in-log evidence for the Croesus mock SaaS OBO flow.
// These queries run in Log Analytics (the workspace that receives the Entra
// sign-in diagnostic settings) and corroborate the PRIMARY evidence, which is
// the API's App Insights claim logging of both token legs.
//
// Run each query block on its own (Log Analytics executes one query at a time).
// Filter by IMMUTABLE application ids, not display names: display names can be
// renamed and are not identity. Substitute the two client-id GUIDs captured from
// scripts/provision-app-registrations.sh output before running:
//   <SPA_CLIENT_ID> -> spa_client_id (interactive SPA client)
//   <API_CLIENT_ID> -> api_client_id (middle-tier API client of the OBO leg)
// Microsoft Graph's immutable appId is the well-known, cross-tenant constant
// 00000003-0000-0000-c000-000000000000 (used below for the Graph resource leg).
//
// These sign-in-log queries are CORROBORATING and BEST-EFFORT: they show two
// distinct sign-in legs of one session (distinct clients, resources, audiences).
// They do NOT and cannot prove that identical bearer-token bytes were reused
// across requests — bearer-byte continuity is not recorded in sign-in logs.
//
// PRIMARY Tier 2a evidence is NOT in these sign-in logs: the API emits a
// distinct App Insights custom event named "ReplayAttempt" for each gated
// server-side replay, kept separate from the OBO "TokenExchange" event so the
// two never mix. Query it in Application Insights (not Log Analytics), e.g.:
//   customEvents | where name == "ReplayAttempt" | order by timestamp desc
// The queries below CORROBORATE that primary evidence from the tenant sign-in
// logs.

// =============================================================================
// Query 1 - Interactive SPA sign-in (leg 0: user -> SPA)
// Lands in SigninLogs because it is an interactive user sign-in.
// =============================================================================
SigninLogs
| where TimeGenerated > ago(1h)
| where AppId == "<SPA_CLIENT_ID>"   // immutable SPA client appId
| project TimeGenerated, CorrelationId, AppId, AppDisplayName, ResourceDisplayName, UserPrincipalName, Status
| sort by TimeGenerated asc

// =============================================================================
// Query 2 - OBO legs (PRIMARY corroboration): API -> API token and API -> Graph
// The middle-tier OBO exchange is non-interactive, so it lands in
// AADNonInteractiveUserSignInLogs. The API->Graph row shows
// ResourceDisplayName == "Microsoft Graph" while the SPA->API row shows the API
// as the resource: distinct tokens for distinct audiences, not one token reused.
// The preserved UserPrincipalName proves the delegated user identity flowed
// through (an app-only client-credentials call would show no user).
// =============================================================================
AADNonInteractiveUserSignInLogs
| where TimeGenerated > ago(1h)
| where AppId == "<API_CLIENT_ID>"   // immutable API client appId (OBO middle tier)
    or ResourceIdentity == "00000003-0000-0000-c000-000000000000"   // Microsoft Graph well-known appId
| project TimeGenerated, CorrelationId, AppId, AppDisplayName, ResourceIdentity, ResourceDisplayName,
          UserPrincipalName, Status
| sort by TimeGenerated asc

// =============================================================================
// Query 3 - Token Protection bound vs unbound (OPTIONAL, ADVANCED EXHIBIT ONLY)
// NOT the OBO proof. The Token Protection / sign-in-session-binding signal
// (signInSessionStatusCode 1008 = unbound) is populated for native apps on
// registered devices accessing Exchange Online / SharePoint Online / Teams, and
// will generally NOT appear for a browser SPA + custom API + Graph flow. Include
// this only as a separate, clearly-labeled "device-bound session" exhibit.
// =============================================================================
AADNonInteractiveUserSignInLogs
| where TimeGenerated > ago(7d)
| where TokenProtectionStatusDetails != ""
| extend d = parse_json(TokenProtectionStatusDetails)
| extend bindingStatus     = tostring(d["signInSessionStatus"])     // "Bound" / "Unbound"
| extend bindingStatusCode = tostring(d["signInSessionStatusCode"]) // 1002/1003/1005/1006/1008
| project TimeGenerated, UserPrincipalName, AppDisplayName, ResourceDisplayName,
          bindingStatus, bindingStatusCode
| sort by TimeGenerated desc

// =============================================================================
// Query 4 - Unbound / 1008 evidence (Tier 2b, SUPPORTED-RESOURCE EXHIBIT ONLY)
// Surfaces non-interactive sign-ins that Token Protection evaluated as Unbound
// with signInSessionStatusCode 1008 ("the client isn't integrated with the
// platform broker, such as Windows Account Manager (WAM)"). This populates ONLY
// when a report-only (or enforced) Token Protection CA policy is in scope for a
// native-app client reaching Exchange Online / SharePoint Online / Teams; it
// will NOT appear for the browser SPA -> custom API -> Graph flow. Provision the
// report-only policy with scripts/provision-ca-policy.sh first.
// =============================================================================
AADNonInteractiveUserSignInLogs
| where TimeGenerated > ago(7d)
| where TokenProtectionStatusDetails != ""
| extend parsed = parse_json(TokenProtectionStatusDetails)
| extend bindingStatus     = tostring(parsed["signInSessionStatus"])     // "Unbound"
| extend bindingStatusCode = tostring(parsed["signInSessionStatusCode"]) // "1008"
| where bindingStatusCode == "1008"
| project TimeGenerated, UserPrincipalName, AppDisplayName, ResourceDisplayName,
          IPAddress, bindingStatus, bindingStatusCode, CorrelationId, Id
| sort by TimeGenerated desc

// =============================================================================
// Query 5 - Correlate the two legs (interactive SPA sign-in <-> non-interactive
// second leg). Joins SigninLogs (leg 1, interactive) to
// AADNonInteractiveUserSignInLogs (leg 2, non-interactive) on CorrelationId +
// UserPrincipalName, so the two legs of one session sit side by side: distinct
// resources, distinct IPs, and (when a Token Protection policy is in scope) the
// leg-2 binding status. This correlation is BEST-EFFORT ONLY: CorrelationId is
// derived from client-passed parameters (so the join also pins
// UserPrincipalName), and the join corroborates two distinct sign-in legs of one
// session — it does NOT and cannot prove that identical bearer-token bytes were
// reused across requests. Widen the time window or add UniqueTokenIdentifier if a
// session does not line up.
// =============================================================================
let interactive =
    SigninLogs
    | where TimeGenerated > ago(1d)
    | where AppId == "<SPA_CLIENT_ID>"   // immutable SPA client appId
    | project L1_Time=TimeGenerated, CorrelationId, UserPrincipalName,
              L1_IP=IPAddress, L1_Resource=ResourceDisplayName,
              L1_UniqueTokenId=UniqueTokenIdentifier;
let secondLeg =
    AADNonInteractiveUserSignInLogs
    | where TimeGenerated > ago(1d)
    | extend tp = parse_json(TokenProtectionStatusDetails)
    | project L2_Time=TimeGenerated, CorrelationId, UserPrincipalName,
              L2_IP=IPAddress, L2_Resource=ResourceDisplayName, L2_App=AppDisplayName,
              L2_Bind=tostring(tp["signInSessionStatus"]),
              L2_Code=tostring(tp["signInSessionStatusCode"]);
interactive
| join kind=inner secondLeg on CorrelationId, UserPrincipalName
| project UserPrincipalName, CorrelationId, L1_Time, L1_IP, L1_Resource,
          L2_Time, L2_IP, L2_App, L2_Resource, L2_Bind, L2_Code
| sort by L1_Time desc
