<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Croesus.BffYarp</RootNamespace>
    <AssemblyName>Croesus.BffYarp</AssemblyName>
    <UserSecretsId>croesus-bff-yarp-poc</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- App Service Windows workers are x64. Left to the host, an ARM64 developer machine publishes a package
         the worker cannot load, and the site fails after a deployment that reported success. These apply to
         publish only, so local build and test still run on the developer's own architecture. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishRuntimeIdentifier>win-x64</PublishRuntimeIdentifier>
    <PublishSelfContained>true</PublishSelfContained>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.15.0" />
    <PackageReference Include="Microsoft.Identity.Web.TokenCache" Version="4.15.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Croesus.BffYarp.Tests" />
  </ItemGroup>

</Project>
