                  {
                    "category": "SignInLogs",
                    "enabled": true
                  },
                  {
                    "category": "NonInteractiveUserSignInLogs",
                    "enabled": true
                  },
                  {
                    "category": "AuditLogs",
                    "enabled": true
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
              ]
            }
          ],
          "outputs": {
