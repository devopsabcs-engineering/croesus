              "name": "[format('{0}/{1}', parameters('privateEndpointName'), format('{0}-dns', parameters('privateEndpointName')))]",
              "properties": {
                "privateDnsZoneConfigs": [
                  {
                    "name": "privatelink-azurewebsites-net",
                    "properties": {
                      "privateDnsZoneId": "[parameters('privateDnsZoneResourceId')]"
                    }
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/privateEndpoints', parameters('privateEndpointName'))]"
              ]
            },
            {
              "type": "Microsoft.Network/privateEndpoints",
              "apiVersion": "2024-05-01",
              "name": "[parameters('privateEndpointName')]",
              "location": "[parameters('location')]",
              "properties": {
                "subnet": {
                  "id": "[parameters('subnetResourceId')]"
                },
                "privateLinkServiceConnections": [
                  {
                    "name": "[parameters('privateEndpointName')]",
                    "properties": {
                      "privateLinkServiceId": "[parameters('siteResourceId')]",
                      "groupIds": [
                        "sites"
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "outputs": {
            "privateEndpointId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the private endpoint."
              },
              "value": "[resourceId('Microsoft.Network/privateEndpoints', parameters('privateEndpointName'))]"
            },
            "privateEndpointName": {
              "type": "string",
              "metadata": {
                "description": "Name of the private endpoint."
              },
              "value": "[parameters('privateEndpointName')]"
            }
          }
        }
      },
      "dependsOn": [
        "bffApp"
      ]
    }
  },
  "outputs": {
    "appServicePlanName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared Windows App Service plan."
      },
      "value": "[variables('appServicePlanName')]"
    },
    "resolvedAppServicePlanSkuName": {
      "type": "string",
      "metadata": {
        "description": "Resolved App Service plan SKU name, so verification can read intent rather than infer it."
      },
      "value": "[parameters('appServicePlanSkuName')]"
    },
    "resolvedIngressMode": {
      "type": "string",
      "metadata": {
        "description": "Resolved ingress posture applied to every site in this deployment."
      },
      "value": "[parameters('ingressMode')]"
    },
    "ingressTierGuard": {
      "type": "string",
      "metadata": {
        "description": "Outcome of the ingress and plan tier compatibility guard."
      },
      "value": "[variables('ingressTierGuard')]"
    },
    "legacyAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the legacy .NET Framework web app."
      },
      "value": "[variables('legacyAppName')]"
    },
    "modernAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the modern self-contained .NET web app."
      },
      "value": "[variables('modernAppName')]"
    },
    "legacyHostName": {
      "type": "string",
      "metadata": {
        "description": "Default host name of the legacy web app."
      },
      "value": "[reference('legacyApp').defaultHostName]"
    },
    "modernHostName": {
      "type": "string",
      "metadata": {
        "description": "Default host name of the modern web app."
      },
      "value": "[reference('modernApp').defaultHostName]"
    },
    "legacyBaseUrl": {
      "type": "string",
      "metadata": {
        "description": "HTTPS base URL of the legacy web app."
      },
      "value": "[variables('legacyBaseUrl')]"
    },
    "modernBaseUrl": {
      "type": "string",
      "metadata": {
        "description": "HTTPS base URL of the modern web app."
      },
      "value": "[variables('modernBaseUrl')]"
    },
    "legacyCallbackUri": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra web callback URI of the legacy web app."
      },
      "value": "[variables('legacyCallbackUri')]"
    },
    "modernCallbackUri": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra web callback URI of the modern web app."
      },
      "value": "[variables('modernCallbackUri')]"
    },
    "bffSiteDeployed": {
      "type": "bool",
      "metadata": {
        "description": "Whether the reference BFF site was provisioned by this deployment."
      },
      "value": "[parameters('deployBffSite')]"
    },
    "bffAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the reference BFF web app, distinct from the legacy and modern comparison apps."
      },
      "value": "[variables('bffAppName')]"
    },
    "bffHostName": {
      "type": "string",
      "metadata": {
        "description": "Default host name of the reference BFF web app. Stable whether or not the site is provisioned, so a registration can claim it before hosting exists."
      },
      "value": "[variables('bffHostName')]"
    },
    "bffBaseUrl": {
      "type": "string",
      "metadata": {
        "description": "HTTPS base URL of the reference BFF web app."
      },
      "value": "[variables('bffBaseUrl')]"
    },
    "bffCallbackUri": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra web callback URI of the reference BFF web app."
      },
      "value": "[variables('bffCallbackUri')]"
    },
    "ownedApiSiteDeployed": {
      "type": "bool",
      "metadata": {
        "description": "Whether the owned API site the BFF proxies to was provisioned by this deployment."
      },
      "value": "[parameters('deployOwnedApiSite')]"
    },
    "ownedApiAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the owned API web app."
      },
      "value": "[variables('ownedApiAppName')]"
    },
    "ownedApiHostName": {
      "type": "string",
      "metadata": {
        "description": "Default host name of the owned API web app."
      },
      "value": "[variables('ownedApiHostName')]"
    },
    "ownedApiBaseUrl": {
      "type": "string",
      "metadata": {
        "description": "HTTPS base URL of the owned API web app, which is also the origin the BFF is permitted to reach."
      },
      "value": "[variables('ownedApiBaseUrl')]"
    },
    "ownedApiRegistrationDisplayName": {
      "type": "string",
      "metadata": {
        "description": "Display name of the Microsoft Entra registration that must expose the delegated scope. Provisioned by scripts/provision-owned-api-registration.ps1, separately from the shared web registration."
      },
      "value": "[variables('ownedApiAppName')]"
    },
    "ownedApiDelegatedScope": {
      "type": "string",
      "metadata": {
        "description": "Delegated scope the BFF requests for the owned API. Empty until ownedApiClientId is supplied."
      },
      "value": "[if(parameters('deployOwnedApiSite'), variables('ownedApiDelegatedScope'), '')]"
    },
    "registrationInputs": {
      "type": "object",
      "metadata": {
        "description": "Non-secret inputs for converging the shared Microsoft Entra web registration."
      },
      "value": {
        "allowedTenantIds": "[variables('effectiveAllowedTenantIds')]",
        "authenticationMode": "[parameters('authenticationMode')]",
        "clientId": "[parameters('clientId')]",
        "displayName": "[format('croesus-bff-{0}-web', variables('uniqueSuffix'))]",
        "homeTenantId": "[parameters('tenantId')]",
        "signInAudience": "[if(equals(parameters('authenticationMode'), 'Organizations'), 'AzureADMultipleOrgs', 'AzureADMyOrg')]",
        "webRedirectUris": "[if(parameters('deployBffSite'), createArray(variables('legacyCallbackUri'), variables('modernCallbackUri'), variables('bffCallbackUri')), createArray(variables('legacyCallbackUri'), variables('modernCallbackUri')))]"
      }
    }
  }
}