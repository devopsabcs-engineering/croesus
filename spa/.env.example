# Croesus SPA build configuration (public, non-secret values only).
# Copy to .env.local and fill in real values from the provisioning outputs.
# CRITICAL: no Microsoft Graph scope belongs here. The SPA requests ONLY the API scope.

# SPA (public client) app registration ID.
VITE_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Microsoft Entra tenant ID.
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000

# API delegated scope exposed by the middle-tier API: api://<API_CLIENT_ID>/access_as_user
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Base URL of the API the SPA calls (no trailing slash).
VITE_API_BASE_URL=http://localhost:5000
